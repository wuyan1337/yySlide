# yySlide Cloud production example. Do not put a real secret in this file.
NODE_ENV=production
YYSLIDE_CLOUD_HOST=127.0.0.1
YYSLIDE_CLOUD_PORT=8787
YYSLIDE_CLOUD_DATA=/var/lib/yyslide-cloud
YYSLIDE_CLOUD_DB=/var/lib/yyslide-cloud/yycloud.sqlite
YYSLIDE_SERVER_SECRET_FILE=/etc/yyslide-cloud/server-secret
YYSLIDE_SESSION_DAYS=30
YYSLIDE_TRUST_PROXY=1

# Comma-separated browser origins only when browser clients are used.
# YYSLIDE_CORS_ORIGIN=https://example.com

# Resource limits. Tune them deliberately for the host capacity.
YYSLIDE_MAX_USERS=10000
YYSLIDE_MAX_PENDING_REGISTRATIONS=5000
YYSLIDE_MAX_SESSIONS_PER_USER=20
YYSLIDE_MAX_VAULT_BYTES=2097152
YYSLIDE_MAX_SSE_PER_USER=5
YYSLIDE_MAX_SSE_PER_IP=20
YYSLIDE_MAX_SSE_TOTAL=1000
YYSLIDE_MAX_SSE_BUFFER_BYTES=65536
YYSLIDE_MAX_RATE_BUCKETS=10000
YYSLIDE_SCRYPT_CONCURRENCY=2
YYSLIDE_SCRYPT_QUEUE_LIMIT=32
